# Replace every /absolute/path/to/k8s-dev-test with the HOST checkout path.
# The Docker daemon resolves bind sources on the host, not inside /workspace.
COMPOSE_PROJECT_NAME=platform-logging
LOGGING_CONFIG_DIR=/absolute/path/to/k8s-dev-test/compose/logging/config
LOGGING_SCRIPTS_DIR=/absolute/path/to/k8s-dev-test/compose/logging/scripts
LOGGING_TLS_DIR=/absolute/path/to/k8s-dev-test/compose/logging/runtime/tls
LOGGING_SECRETS_DIR=/absolute/path/to/k8s-dev-test/compose/logging/runtime/secrets
LOGGING_SNAPSHOT_DIR=/absolute/path/to/k8s-dev-test/compose/logging/runtime/snapshots
ELASTICSEARCH_BIND_ADDRESS=127.0.0.1
KIBANA_BIND_ADDRESS=127.0.0.1
LOGSTASH_BIND_ADDRESS=127.0.0.1
ELASTICSEARCH_PORT=9200
KIBANA_PORT=5601
LOGSTASH_HTTPS_PORT=8443
LOGSTASH_BEATS_PORT=5044
KIBANA_PUBLIC_URL=https://localhost:5601
# Elasticsearch heap is pinned in config/jvm.options.d/platform.options.
ES_MEMORY_LIMIT=4g
ES_CPU_LIMIT=2.0
KIBANA_MEMORY_LIMIT=2g
KIBANA_CPU_LIMIT=1.0
LOGSTASH_MEMORY_LIMIT=2g
LOGSTASH_CPU_LIMIT=2.0
LOGSTASH_JAVA_OPTS=-Xms1g -Xmx1g
