# Configuration schema example. Do not use this path until it exists on the daemon host.
MONITORING_PROJECT_NAME=platform-monitoring
MONITORING_CONFIG_DIR=/srv/platform/compose/monitoring/config

# Exact release tags; pin verified registry digests as part of production release approval.
PROMETHEUS_IMAGE=prom/prometheus:v3.13.3
ALERTMANAGER_IMAGE=prom/alertmanager:v0.34.1
GRAFANA_IMAGE=grafana/grafana:13.2.2

PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
GRAFANA_PORT=3000
PROMETHEUS_EXTERNAL_URL=http://localhost:9090/
ALERTMANAGER_EXTERNAL_URL=http://localhost:9093/
GRAFANA_ROOT_URL=http://localhost:3000/
GRAFANA_DOMAIN=localhost
GRAFANA_COOKIE_SECURE=false
GRAFANA_ADMIN_USER=admin

PROMETHEUS_CPUS=2.0
PROMETHEUS_MEMORY=2g
PROMETHEUS_RETENTION_TIME=15d
PROMETHEUS_RETENTION_SIZE=10GB
ALERTMANAGER_CPUS=0.5
ALERTMANAGER_MEMORY=256m
GRAFANA_CPUS=1.0
GRAFANA_MEMORY=1g
