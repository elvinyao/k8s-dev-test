# Example values validate syntax only. Create an ignored .env for deployment.
# Verified on 2026-09-26 against the publishers' Docker Hub tags.
GITLAB_IMAGE=gitlab/gitlab-ee:19.4.1-ee.0@sha256:803e5887cd561ed49ce84c92756838d39e9bcef5c061d4399f2e1057a335cae2
GITLAB_RUNNER_IMAGE=gitlab/gitlab-runner:alpine-v19.4.1
GITLAB_HOSTNAME=gitlab.example.invalid
GITLAB_EXTERNAL_URL=https://gitlab.example.invalid
GITLAB_HTTP_BIND=127.0.0.1
GITLAB_HTTP_PORT=8929
GITLAB_SSH_BIND=127.0.0.1
GITLAB_SSH_PORT=2222
# Replace with the actual proxy peer IP/CIDR as seen by GitLab, including NAT.
GITLAB_TRUSTED_PROXIES=192.0.2.10/32
GITLAB_CPUS=8
GITLAB_MEMORY=16g
# All paths refer to the Docker daemon host, not /workspace in the tooling container.
GITLAB_CONFIG_DIR=/srv/gitlab/config
GITLAB_LOGS_DIR=/srv/gitlab/logs
GITLAB_DATA_DIR=/srv/gitlab/data
GITLAB_BACKUPS_DIR=/srv/gitlab/backups
GITLAB_ROOT_PASSWORD_FILE=/srv/gitlab/secrets/root_password
GITLAB_RUNNER_CONFIG_DIR=/srv/gitlab/runner
