apiVersion: v1
kind: Config
current-context: gitlab-ci
clusters:
  - name: build-cluster
    cluster:
      server: https://api.example.invalid:6443
      certificate-authority: /etc/gitlab-runner/kubernetes/ca.crt
contexts:
  - name: gitlab-ci
    context:
      cluster: build-cluster
      namespace: ci-jobs
      user: gitlab-runner-manager
users:
  - name: gitlab-runner-manager
    user:
      tokenFile: /etc/gitlab-runner/kubernetes/token
