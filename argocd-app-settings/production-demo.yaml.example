apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: production-demo
  namespace: argocd
spec:
  project: platform-apps-production
  source:
    # Replace BOTH this URL and the AppProject sourceRepos with the real business repo.
    repoURL: https://git.example.invalid/business/deployments.git
    # All-zero full SHA is a deliberate NONEXISTENT placeholder, not a verified commit.
    # Replace it with the reviewed full commit SHA after copying/pushing the app files.
    targetRevision: "0000000000000000000000000000000000000000"
    path: apps/production-demo
  destination:
    server: https://kubernetes.default.svc
    namespace: apps-prod
  syncPolicy:
    syncOptions:
      - FailOnSharedResource=true
