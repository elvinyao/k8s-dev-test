# AWS example ONLY. Requires the EBS CSI driver and its IAM/workload identity.
apiVersion: storage.k8s.io/v1
kind: StorageClass
metadata:
  name: production-rwo
provisioner: ebs.csi.aws.com
parameters:
  type: gp3
  encrypted: "true"
reclaimPolicy: Retain
allowVolumeExpansion: true
volumeBindingMode: WaitForFirstConsumer
